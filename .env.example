# Elexon BMRS API
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1

# Forecast cutoff: hour (UTC) on D-1 when day-ahead purchasing decision is made
FORECAST_CUTOFF_HOUR=9

# Analysis period
ANALYSIS_YEAR=2026
ANALYSIS_MONTH=1

# Backend
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# Frontend
VITE_API_URL=http://localhost:8000/api

# Cache
CACHE_DIR=./cache

# HTTPX settings
HTTPX_TIMEOUT=30.0
HTTPX_MAX_RETRIES=3
